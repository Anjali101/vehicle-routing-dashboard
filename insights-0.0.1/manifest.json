{
  "_version": "1.65.0",
  "sap.app": {
    "id": "insights",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ]
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.18.2",
      "toolsId": "5ee923fb-20ce-4bc1-a906-d7c15bff2d4c"
    },
    "crossNavigation": {
      "inbounds": {
        "insights-display": {
          "semanticObject": "insights",
          "action": "display",
          "title": "Insights",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/insights/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.138.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "insights.i18n.i18n",
          "supportedLocales": [
            ""
          ]
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            ""
          ]
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ScenarioInsightsList",
          "target": "ScenarioInsightsList"
        },
        {
          "pattern": "ScenarioInsights({key}):?query:",
          "name": "ScenarioInsightsObjectPage",
          "target": "ScenarioInsightsObjectPage"
        }
      ],
      "targets": {
        "ScenarioInsightsList": {
          "type": "Component",
          "id": "ScenarioInsightsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ScenarioInsights",
              "tableSettings": {
                "initialSortOrder": [
                  {
                    "property": "challengeIntensity",
                    "descending": true
                  }
                ]
              },
              "initialLoad": true,
              "variantManagement": "Page",
              "navigation": {
                "ScenarioInsights": {
                  "detail": {
                    "route": "ScenarioInsightsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ScenarioInsightsObjectPage": {
          "type": "Component",
          "id": "ScenarioInsightsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "simpleHeaderFacets": true,
              "editableHeaderContent": true,
              "contextPath": "/ScenarioInsights"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}