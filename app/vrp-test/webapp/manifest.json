{
  "sap.app": {
    "id": "vrptest",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:alp",
      "version": "1.17.6",
      "toolsId": "8a823f0b-4687-4eca-93ee-ccc11d409c26"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/visualization/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "display": {
        "semanticObject": "vrptest",
        "action": "display",
        "title": "VRP Route visualization",
        "signature": {
          "parameters": {},
          "additionalParameters": "allowed"
        }
      },
        "VehicleStats-display": {
          "semanticObject": "VehicleStats",
          "action": "display",
          "title": "Vehicle Chart",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }

        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
  
  "extends": {
  "extensions": {
    "sap.ui.viewExtensions": {
      "sap.fe.templates.AnalyticalListPage.AnalyticalListPage": {
        "AfterFacetHeaderActions": {
          "className": "sap.ui.core.Fragment",
          "fragmentName": "vrptest.ext.fragment.VehicleStatsButton",
          "type": "XML"
        }
      }
    }
  }
}
},
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "vrptest.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {"async": true},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "RoutelocationsList",
          "target": "RoutelocationsList"
        },
        {
          "pattern": "Routelocations({key}):?query:",
          "name": "RoutelocationsObjectPage",
          "target": "RoutelocationsObjectPage"
        },
        {
          "pattern": "VehicleStats",
          "name": "VehicleStats",
          "target": "VehicleStats"
        }
      ],
      "targets": {
        "RoutelocationsList": {
          "content": {
  "body": {
    "sections": {
      "section_0": {
        "template": "sap.fe.macros.ChartTable",
        "actions": {
          "navigateToVehicleStats": {
            "id": "vehicleStatsChartButton",
            "text": "Vehicle Chart",
            "icon": "sap-icon://line-chart",
            "press": "my.namespace.ext.controller.CustomActions.navigateToVehicleStats"
          }
        }
      }
    }
  }
},
          "type": "Component",
          "id": "RoutelocationsList",
          "controllerName": "vrptest.ext.controller.AnalyticalListPageExt",
          "name": "sap.fe.templates.AnalyticalListPage",
          "options": {
            "settings": {
              "initialLoad": true,
              "contextPath": "/Routelocations",
              "variantManagement": "Page",
              "navigation": {
                "Routelocations": {
                  "detail": {
                    "route": "RoutelocationsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                 "actions": {
            "openDiagram": {
                "id": "openUpDiagram",
                "text": "{{Generate_Diagram}}",
                "press": ".extension.ns.incidents.controller.ListReportExt.openDiagram",
                "requiresSelection": false
            }
        },
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "primary": [
                      {
                        "annotationPath": "com.sap.vocabularies.UI.v1.Chart"
                      }
                    ],
                    "secondary": [
                      {
                        "annotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant"
                      }
                    ],
                    "defaultPath": "both"
                  }
                ]
              }
            }
          }
          
        },
        "RoutelocationsObjectPage": {
          "type": "Component",
          "id": "RoutelocationsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": true,
              "contextPath": "/Routelocations"
            }
          }
        },
        "VehicleStats": {
  "type": "Component",
  "id": "VehicleStats",
  "name": "sap.fe.templates.ListReport",
  "options": {
    "settings": {
      "entitySet": "VehicleDistribution",
      "variantManagement": "None"
    }
  }
}
      }
    },
    "VehicleStats": {
  "_version": "1.1.0",
  "id": "VehicleStats",
  "usage": "VehicleStats",
  "type": "Component",
  "name": "sap.fe.templates.ListReport",
  "options": {
    "settings": {
      "entitySet": "VehicleDistribution",
      "variantManagement": "None",
      "controlConfiguration": {
        "@com.sap.vocabularies.UI.v1.LineItem": {
          "tableSettings": {
            "type": "ResponsiveTable"
          }
        }
      }
    }
  },
  "sap.ui.generic.app": {
  "pages": {
    "RouteObjectPage": {
      "component": {
        "settings": {
          "content": {
            "body": {
              "sections": {
                "CustomersTab": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "fitContainer": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
}
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  }
  
}
